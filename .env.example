# Gmail notifications for new registrations
# Use a Gmail App Password, not your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
REGISTRATION_NOTIFICATION_TO=
EMAIL_FROM=

# Admins allowed to call protected backend Firebase routes
ADMIN_EMAILS=nallbanigeno@gmail.com

# Optional Firebase Admin service account JSON for local/server auth user creation.
# GOOGLE_APPLICATION_CREDENTIALS also works if your runtime uses that pattern.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Legacy aliases still supported by server.ts:
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_TO=

# Firebase Configuration (Already handled by firebase-applet-config.json)
# GEMINI_API_KEY is provided by the environment
