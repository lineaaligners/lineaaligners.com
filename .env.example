# Email Configuration for Admin Notifications
# Recommened to use App Passwords if using Gmail
EMAIL_USER=
EMAIL_PASS=

# Firebase Configuration (Already handled by firebase-applet-config.json)
# GEMINI_API_KEY is provided by the environment

# --- OnyxCeph treatment-plan links ---
APP_URL=https://lineaaligners.com
# comma-separated, exact host[:port] values verified from a real OnyxCeph export
ONYX_VIEWER_HOSTS=www.image-instruments.de
ONYX_VIEWER_PATHS=/webviewer/index.html
ONYX_MODEL_HOSTS=your-export-server.example:2011
# server only — never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=
