{
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/portal/index.html"
    },
    {
      "source": "/portal/:path*",
      "destination": "/portal/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/assessment",
      "destination": "/assessment/index.html"
    },
    {
      "source": "/assessment/:path*",
      "destination": "/assessment/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "0 7 * * *"
    }
  ]
}